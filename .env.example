# ================= 应用基础 =================
APP_NAME=Cross-border E-commerce Ad Agent
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# ================= 数据库 =================
DATABASE_URL=sqlite:///./data/ad_agent.db

# ================= Redis =================
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# ================= 存储 =================
STORAGE_TYPE=local
STORAGE_DIR=./data/storage
ASSETS_DIR=../assets
# S3 / MinIO（STORAGE_TYPE=s3|minio 时生效；s3/minio 共用以下变量）
# 生产推荐走后端分发静态资源——前端访问地址由 S3_PUBLIC_URL 指定
# （如经 API 域名或 CDN 代理后的公开地址），服务端内部下载仍用 S3_ENDPOINT。
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=ad-agent-bucket
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PUBLIC_URL=https://files.example.com
# 阿里云 OSS（STORAGE_TYPE=oss 时生效，bucket 建议公共读）
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_BUCKET=your-bucket-name
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# ================= LLM =================
# provider: openai / claude / qwen / gemini / kimi / mock
# kimi 示例：LLM_PROVIDER=kimi  LLM_MODEL=kimi-k2.6  LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_PATH=/v1/messages
# 推理型模型（kimi-k3 / kimi-k2.x）只接受 1，填其他值会被客户端自动忽略
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
# 客户端限流（每分钟最大请求数，0=不限流）。上游账号有组织级 RPM 上限时必须设置，
# 否则流水线连续调用会大量 429（Kimi 新账号默认仅 3）
LLM_MAX_RPM=0
# 思考模式开关：留空不干预 / enabled / disabled（仅 kimi-k2.x 等支持开关的模型生效）
LLM_THINKING=
# 推理强度（仅 kimi-k3 生效）：low / high / max，留空用上游默认 max
LLM_REASONING_EFFORT=
VISION_PROVIDER=mock
VISION_MODEL=gpt-4o

# ================= 阿里云 DashScope（Embedding + 通义万相出图） =================
# 与对话模型解耦：LLM 换成第三方模型后，知识库检索与出图仍需要 DashScope 密钥
# 未配置且 LLM_PROVIDER=qwen 时会回退复用 LLM_API_KEY
DASHSCOPE_API_KEY=
# Embedding 服务地址，留空按嵌入提供商自动选择
EMBEDDING_BASE_URL=

# ================= Embedding =================
# provider: openai / bge-m3 / dashscope / mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ================= 向量库 =================
VECTOR_STORE_TYPE=chroma
CHROMA_DIR=./data/chroma
# MILVUS_URI=

# ================= Rerank =================
RERANK_PROVIDER=none
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=5

# ================= 图像生成 =================
# provider: openai / dashscope(通义万相) / sd / flux / mock
IMAGE_PROVIDER=mock
IMAGE_MODEL=wanx2.1-t2i-turbo

# ================= Mock 模式 =================
MOCK_MODE=true

# ================= 可观测 =================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=

# ================= 安全 =================
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=10
# 广告生成任务并发上限（独立线程池）
TASK_MAX_WORKERS=4
# 非空时 /files 静态资源需携带 ?token= 或 X-File-Token 头才能访问（生产务必配置）
FILE_ACCESS_TOKEN=
# 静态资源签名 URL 密钥（HMAC）。非空时后端返回的图片地址自动带 exp/sig 签名，
# /files 校验签名通过才放行（比固定 token 更安全，推荐生产使用）
FILE_URL_SECRET=
# 签名有效期（秒），默认 86400
FILE_URL_TTL_SECONDS=86400
# CORS 是否允许携带凭证；与 CORS_ORIGINS=["*"] 互斥（通配符时自动降级为 false）
CORS_ALLOW_CREDENTIALS=false
# 生产环境发现致命安全问题时是否拒绝启动（false 仅告警）
STRICT_SECURITY=true
# /metrics 运行指标端点访问令牌，非空时需 ?token= 或 X-Metrics-Token 头
# （同时保护新增的 /metrics/prometheus 文本指标，供 Prometheus 抓取 / Grafana 接入）
METRICS_TOKEN=

# ================= 迁移 =================
# 启动时自动执行 alembic upgrade head（失败回退轻量建表/补列）
AUTO_MIGRATE=true

# ================= 成本 =================
# 覆盖模型单价（USD/百万 token），格式 {"模型名": [输入, 输出]}，留空用内置默认表
MODEL_PRICING={}
